---
import { sectionLabel, sections, siteConfig } from "@/config/site";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
---

<header class="group sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="font-serif text-lg font-semibold tracking-tight transition-colors hover:text-primary"
    >
      {siteConfig.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <!-- Below xl there is no side table of contents, so every section goes
           in a menu. The Popover API gives light dismiss, Escape to close and
           focus handling without JS. -->
      <button
        type="button"
        popovertarget="site-menu"
        class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground xl:hidden"
        aria-label="Menu"
      >
        <svg
          class="size-4 group-has-[#site-menu:popover-open]:hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          class="hidden size-4 group-has-[#site-menu:popover-open]:block"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
      <ThemeToggle />
    </div>
  </nav>

  <div
    id="site-menu"
    popover
    class="inset-x-0 top-[3.6rem] bottom-auto m-0 h-auto w-auto border-0 border-b border-border bg-background text-foreground shadow-lg backdrop:bg-black/20 xl:hidden"
  >
    <nav aria-label="Sections" class="mx-auto max-w-3xl px-4 py-3 sm:px-6">
      <ul class="grid grid-cols-2 gap-x-4 text-base">
        {sections.map((section) => (
          <li>
            <a
              href={`/#${section.id}`}
              class="block rounded-md px-2 py-2 transition-colors hover:bg-muted hover:text-primary"
            >
              {sectionLabel(section)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Close the menu once a section is picked so the page is visible again.
  const menu = document.getElementById("site-menu");
  menu
    ?.querySelectorAll("a")
    .forEach((link) =>
      link.addEventListener("click", () => menu.hidePopover()),
    );
</script>
