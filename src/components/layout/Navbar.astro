---
import { sectionLabel, sections, siteConfig } from "@/config/site";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";

interface Props {
  /**
   * Float over the hero: transparent at the top of the page, then solid
   * with the site name once the page's own <h1 id="name"> has scrolled away.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header
  id="site-header"
  data-overlay={overlay || undefined}
  class="group sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur"
>
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a
      href="/"
      class="site-brand font-serif text-lg font-semibold tracking-tight transition-colors hover:text-primary"
    >
      {siteConfig.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <!-- Below xl there is no side table of contents, so every section goes
           in a menu. The Popover API gives light dismiss, Escape to close and
           focus handling without JS. -->
      <button
        type="button"
        popovertarget="site-menu"
        class="rounded-full p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground xl:hidden"
        aria-label="Menu"
      >
        <svg
          class="size-4 group-has-[#site-menu:popover-open]:hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          class="hidden size-4 group-has-[#site-menu:popover-open]:block"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
      <ThemeToggle />
    </div>
  </nav>

  <div
    id="site-menu"
    popover
    class="inset-x-0 top-[3.55rem] bottom-auto m-0 h-auto w-auto border-0 border-b border-border bg-background text-foreground shadow-lg xl:hidden"
  >
    <nav aria-label="Sections" class="mx-auto max-w-3xl px-4 py-3 sm:px-6">
      <ul class="grid grid-cols-2 gap-x-4 text-base">
        {sections.map((section) => (
          <li>
            <a
              href={`/#${section.id}`}
              class="block rounded-md px-2 py-2 transition-colors hover:bg-muted hover:text-primary"
            >
              {sectionLabel(section)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Close the menu once a section is picked so the page is visible again.
  const menu = document.getElementById("site-menu");
  menu
    ?.querySelectorAll("a")
    .forEach((link) =>
      link.addEventListener("click", () => menu.hidePopover()),
    );

  // Overlay header: bare until the hero's name heading has gone up under it,
  // then solid with the site name. One signal for both, so the bar never
  // shows up empty.
  const header = document.getElementById("site-header");
  if (header?.hasAttribute("data-overlay")) {
    const heading = document.getElementById("name");
    if (heading) {
      new IntersectionObserver(
        // Out of view *above* the header's bottom edge (the root's top),
        // not below the viewport. Compare with that edge, not with 0: the
        // callback fires the moment the heading slides under the header,
        // when its top is still at a small positive y, and doesn't fire
        // again until it comes back.
        ([entry]) =>
          header.toggleAttribute(
            "data-past-name",
            !entry.isIntersecting &&
              entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0),
          ),
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
      ).observe(heading);
    }
  }
</script>
