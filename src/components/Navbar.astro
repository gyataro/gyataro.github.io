---
const path = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur border-b border-main">
  <nav class="mx-auto max-w-5xl px-10 h-12 flex items-center gap-2">
    <a
      href="/"
      class:list={["px-2 py-1 text-sm transition-colors hover:text-primary", { "text-main font-semibold": path === "/", "text-muted": path !== "/" }]}
      aria-current={path === "/" ? "page" : undefined}
    >Home</a>
    <a
      href="/publications"
      class:list={["px-2 py-1 text-sm transition-colors hover:text-primary", { "text-main font-semibold": path.startsWith("/publications"), "text-muted": !path.startsWith("/publications") }]}
      aria-current={path.startsWith("/publications") ? "page" : undefined}
    >Publications</a>
    <a
      href="/awards"
      class:list={["px-2 py-1 text-sm transition-colors hover:text-primary", { "text-main font-semibold": path.startsWith("/awards"), "text-muted": !path.startsWith("/awards") }]}
      aria-current={path.startsWith("/awards") ? "page" : undefined}
    >Awards</a>
  </nav>
</header>
