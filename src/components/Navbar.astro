---
const path = Astro.url.pathname;

const NAV_LINKS = [
  { href: "/", label: "Home" },
  { href: "/publications", label: "Publications" },
  { href: "/awards", label: "Awards" },
] as const

function isActive(href: string) {
  return href === "/" ? path === "/" : path.startsWith(href)
}
---

<header class="fixed top-0 inset-x-0 z-50 bg-slate-900/95 backdrop-blur border-b border-slate-700">
  <div class="mx-auto max-w-5xl px-10 h-12 flex items-center">
    <!-- Desktop links -->
    <nav class="hidden sm:flex items-center gap-2" aria-label="Main navigation">
      {NAV_LINKS.map(({ href, label }) => (
        <a
          href={href}
          class:list={["px-2 py-1 text-sm transition-colors hover:text-white", { "text-white font-semibold": isActive(href), "text-slate-400": !isActive(href) }]}
          aria-current={isActive(href) ? "page" : undefined}
        >{label}</a>
      ))}
    </nav>

    <!-- Mobile hamburger button -->
    <button
      id="nav-toggle"
      class="sm:hidden flex items-center gap-2 p-1 text-sm text-slate-400 hover:text-white transition-colors"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open navigation menu"
    >
      <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="hidden">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
      <span id="toggle-label">Menu</span>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <nav
    id="mobile-nav"
    class="sm:hidden hidden border-t border-slate-700"
    aria-label="Mobile navigation"
  >
    <div class="mx-auto max-w-5xl px-10 py-3 flex flex-col">
      {NAV_LINKS.map(({ href, label }) => (
        <a
          href={href}
          class:list={["px-2 py-2 text-sm transition-colors hover:text-white", { "text-white font-semibold": isActive(href), "text-slate-400": !isActive(href) }]}
          aria-current={isActive(href) ? "page" : undefined}
        >{label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  import { onPageReady } from "../lib/page-scripts"

  onPageReady(
    { toggle: 'nav-toggle', menu: 'mobile-nav', iconMenu: 'icon-menu', iconClose: 'icon-close', label: 'toggle-label' },
    ({ toggle, menu, iconMenu, iconClose, label }) => {
      function open() {
        menu.classList.remove('hidden')
        toggle.setAttribute('aria-expanded', 'true')
        toggle.setAttribute('aria-label', 'Close navigation menu')
        iconMenu.classList.add('hidden')
        iconClose.classList.remove('hidden')
        label.textContent = 'Close'
      }

      function close() {
        menu.classList.add('hidden')
        toggle.setAttribute('aria-expanded', 'false')
        toggle.setAttribute('aria-label', 'Open navigation menu')
        iconMenu.classList.remove('hidden')
        iconClose.classList.add('hidden')
        label.textContent = 'Menu'
      }

      toggle.addEventListener('click', () => {
        if (menu.classList.contains('hidden')) open()
        else close()
      })

      menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close))
    }
  )
</script>
