---
import PaperIcon from "./icons/paper.astro"
import WebsiteIcon from "./icons/website.astro"
import CodeIcon from "./icons/code.astro"
import { NAME } from "../consts"

interface Props {
  title: string
  venue: string
  authors: string[]
  me?: string
  cofirst?: boolean
  corresponding?: boolean
  links?: {
    paper?: string
    website?: string
    code?: string
  }
}

const { title, venue, authors, me = NAME, cofirst, corresponding, links } = Astro.props
const meIndex = me ? authors.findIndex(a => a.toLowerCase() === me.toLowerCase()) : -1
const hasLinks = links?.paper || links?.website || links?.code
const venueNorm = venue?.trim().toLowerCase()
const showVenue = venueNorm && venueNorm !== 'preprint' && venueNorm !== 'arxiv'
---

<div class="bg-surface border border-line rounded-md px-4 py-3 flex flex-col gap-1.5 hover:bg-surface-hover transition-colors">
  <p class="text-main font-semibold text-sm leading-snug">{title}</p>
  <p class="text-xs text-muted leading-relaxed">{authors.map((a, i) => {
    const marker = (cofirst && (i === 0 || i === 1) ? "*" : "") + (i === meIndex && corresponding ? "#" : "")
    return <><span class:list={[i === meIndex ? "font-bold text-indigo-700" : ""]}>{a}{marker && <sup>{marker}</sup>}</span>{i < authors.length - 1 ? ", " : ""}</>
  })}</p>
  <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-x-4 gap-y-1">
    {showVenue && <span class="text-xs font-medium text-muted">{venue}</span>}
    {hasLinks && (
      <div class="flex items-center gap-3 ml-auto">
        {links?.paper && (
          <a href={links.paper} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1 text-xs text-muted hover:text-primary transition-colors">
            <PaperIcon /><span>Paper</span>
          </a>
        )}
        {links?.website && (
          <a href={links.website} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1 text-xs text-muted hover:text-primary transition-colors">
            <WebsiteIcon /><span>Site</span>
          </a>
        )}
        {links?.code && (
          <a href={links.code} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1 text-xs text-muted hover:text-primary transition-colors">
            <CodeIcon /><span>Code</span>
          </a>
        )}
      </div>
    )}
  </div>
</div>
