---
// Outline icons (Tabler style, 24px grid, 2px stroke) for the contact links.
// ORCID has no Tabler icon, so it is drawn to match: a circle with "iD".
const paths = {
  cv: [
    "M14 3v4a1 1 0 0 0 1 1h4",
    "M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z",
    "M9 13l6 0",
    "M9 17l6 0",
  ],
  scholar: [
    "M22 9l-10 -4l-10 4l10 4l10 -4v6",
    "M6 10.6v5.4a6 3 0 0 0 12 0v-5.4",
  ],
  github: [
    "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
  ],
  linkedin: [
    "M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z",
    "M8 11l0 5",
    "M8 8l0 .01",
    "M12 16l0 -5",
    "M16 16v-3a2 2 0 0 0 -4 0",
  ],
  orcid: [
    "M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0",
    "M8.5 10.5v5",
    "M8.5 8l0 .01",
    "M11.5 8.5v7h1.5a3.5 3.5 0 0 0 0 -7z",
  ],
  email: [
    "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
    "M3 7l9 6l9 -6",
  ],
} as const;

export type ContactIconName = keyof typeof paths;

interface Props {
  name: ContactIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["shrink-0", className]}
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>
