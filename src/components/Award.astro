---
interface Props {
  title: string
  source: string
}

const { title, source } = Astro.props
---
<div class="bg-muted border border-main rounded-md px-4 py-3 flex flex-col gap-1.5 hover:bg-hover transition-colors">
  <p class="text-main font-semibold text-sm leading-snug">{title}</p>
  <p class="text-xs font-medium text-muted">{source}</p>
</div>
