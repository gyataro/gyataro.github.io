---
import { EXTERNAL_LINK_ATTRS } from "../consts"

type Props = {
    text: string
    href: string
    class?: string
}

const props = Astro.props
const isExternal = !props.href.startsWith("mailto:")

const mainStyle = "flex gap-3 text-muted hover:text-primary focus:text-primary w-fit"
const classes = props.class ? [mainStyle, props.class] : mainStyle
---

<a href={props.href} class:list={classes} {...(isExternal ? EXTERNAL_LINK_ATTRS : {})}>
    <slot />
    <p>{props.text}</p>
</a>