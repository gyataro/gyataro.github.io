---
import { getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import profileImg from "../assets/profile.jpg";
import { NAME } from "../consts";

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, schema } = Astro.props;

const ogImage = await getImage({ src: profileImg, width: 1200 });
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<script is:inline>document.documentElement.classList.remove("no-js")</script>
<meta content="IE=edge" http-equiv="X-UA-Compatible" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={NAME} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={NAME} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImage.attributes.width)} />
<meta property="og:image:height" content={String(ogImage.attributes.height)} />

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

{ schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>
)}

<ClientRouter />