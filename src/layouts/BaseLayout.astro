---
import BaseHead from "../components/BaseHead.astro";
import ProfileCard from "../components/ProfileCard.astro";
import Navbar from "../components/Navbar.astro";
import { getPageMeta } from "../consts";
import bannerImg from "../assets/banner.png";

interface Props {
  schema?: Record<string, unknown>;
  showNavBar?: boolean;
  showProfileCard?: boolean;
  noindex?: boolean;
}

const { schema, showNavBar = true, showProfileCard = true, noindex = false } = Astro.props;

const path = Astro.url.pathname;
const { title, description } = getPageMeta(path);
---

<!doctype html>
<html id="root" lang="en" class="bg-white no-js">
  <head>
    <BaseHead title={title} description={description} schema={schema} noindex={noindex} />
  </head>
  <body class="mx-auto p-10 max-w-5xl">
    { showNavBar && <Navbar /> }
    { showNavBar && <div class="h-12" aria-hidden="true" /> }

    { path === "/" && (
      <div
        id="hero-banner"
        data-src={bannerImg.src}
        class="absolute inset-x-0 top-12 h-48 opacity-0 transition-opacity duration-700 ease-out"
        style={`background-image: url(${bannerImg.src}); background-repeat: repeat; background-size: 195px;`}
        aria-hidden="true"
      />
    )}

    <div class="grid grid-cols-1 sm:grid-cols-3 sm:gap-20">
      { showProfileCard && (
        <aside aria-label="Profile" class:list={[
          "relative mb-12 sm:mb-0 sm:col-span-1 sm:sticky sm:top-[5.5rem] sm:h-fit",
          { "hidden sm:block": path !== "/" },
        ]}>
          <ProfileCard />
        </aside>
      )}
      <main class:list={["col-span-1 sm:col-span-2 prose", { "sm:pt-[12rem]": path === "/" }]}>
        <slot />
      </main>
    </div>

    { path === "/" && (
      <script>
        import { onPageReady } from "../lib/page-scripts"

        onPageReady({ banner: "hero-banner" }, ({ banner }) => {
          const src = banner.dataset.src
          if (!src) return
          banner.classList.remove("opacity-30")
          banner.classList.add("opacity-0")
          const img = new Image()
          img.onload = () => banner.classList.replace("opacity-0", "opacity-30")
          img.src = src
        })
      </script>
    )}
  </body>
</html>
