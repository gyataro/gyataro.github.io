---
import { Font } from "astro:assets";
import Seo from "@/components/seo/Seo.astro";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import { siteConfig } from "@/config/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <Seo title={title} description={description} noindex={noindex} />
    <Font cssVariable="--font-inter" preload={[{ weight: "400" }]} />
    <Font cssVariable="--font-newsreader" preload={[{ weight: "600" }]} />
    <slot name="head" />
    <script is:inline>
      // Runs before first paint to avoid a flash of the wrong theme.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {
          // Storage can be blocked (private mode, disabled site data).
        }
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <!-- @container lets full-bleed elements use 100cqw: the body's width,
       which (unlike 100vw) excludes the scrollbar, so nothing overflows. -->
  <body class="@container bg-background font-sans text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only z-50 rounded-md bg-primary px-4 py-2 text-background focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main-content" class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
