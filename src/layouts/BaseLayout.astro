---
import BaseHead from "../components/BaseHead.astro";
import ProfileCard from "../components/ProfileCard.astro";
import Navbar from "../components/Navbar.astro";
import { getPageMeta } from "../consts";
import bannerImg from "../assets/banner.jpg";

interface Props {
  schema?: Record<string, any>;
  showNavBar?: boolean;
  showProfileCard?: boolean;
}

const { schema, showNavBar = true, showProfileCard = true } = Astro.props;

const path = Astro.url.pathname;
const { title, description } = getPageMeta(path);
---

<!doctype html>
<html id="root" lang="en" class="bg-main">
  <head>
    <BaseHead title={title} description={description} schema={schema} />
  </head>
  <body class="mx-auto p-10 max-w-5xl">
    { showNavBar && <Navbar /> }
    { showNavBar && <div class="h-12" aria-hidden="true" /> }

    { path === "/" && (
      <div class="absolute inset-x-0 top-12 h-48 opacity-30" style={`background-image: url(${bannerImg.src}); background-repeat: repeat; background-size: 195px;`} aria-hidden="true" />
    )}

    { showProfileCard && (
      <div class:list={[
        "sm:hidden mb-12 relative",
        { hidden: path !== "/" },
      ]}>
        <ProfileCard />
      </div>
    )}

    <div class="sm:grid sm:grid-cols-3 sm:gap-20">
      { showProfileCard && (
        <div class="hidden sm:block mb-12 sm:mb-0 sm:col-span-1 sm:sticky sm:top-[5.5rem] sm:h-fit">
          <ProfileCard />
        </div>
      )}
      <div class:list={["col-span-2 prose", { "sm:pt-[12rem]": path === "/" }]}>
        <slot />
      </div>
    </div>
  </body>
</html>
