---
import BaseHead from "../components/BaseHead.astro";
import ProfileCard from "../components/ProfileCard.astro";
import Navbar from "../components/Navbar.astro";
import { getPageMeta } from "../consts";
import bannerImg from "../assets/banner.png";

interface Props {
  schema?: Record<string, any>;
  showNavBar?: boolean;
  showProfileCard?: boolean;
}

const { schema, showNavBar = true, showProfileCard = true } = Astro.props;

const path = Astro.url.pathname;
const { title, description } = getPageMeta(path);
---

<!doctype html>
<html id="root" lang="en" class="bg-white">
  <head>
    <BaseHead title={title} description={description} schema={schema} />
  </head>
  <body class="mx-auto p-10 max-w-5xl">
    { showNavBar && <Navbar /> }
    { showNavBar && <div class="h-12" aria-hidden="true" /> }

    { path === "/" && (
      <>
        <div
          id="hero-banner"
          data-src={bannerImg.src}
          class="absolute inset-x-0 top-12 h-48 opacity-0 transition-opacity duration-700 ease-out"
          style={`background-image: url(${bannerImg.src}); background-repeat: repeat; background-size: 195px;`}
          aria-hidden="true"
        />
        <noscript>
          <style>#hero-banner { opacity: 0.3 !important; }</style>
        </noscript>
      </>
    )}

    { showProfileCard && (
      <div class:list={[
        "sm:hidden mb-12 relative",
        { hidden: path !== "/" },
      ]}>
        <ProfileCard />
      </div>
    )}

    <div class="sm:grid sm:grid-cols-3 sm:gap-20">
      { showProfileCard && (
        <div class="hidden sm:block mb-12 sm:mb-0 sm:col-span-1 sm:sticky sm:top-[5.5rem] sm:h-fit">
          <ProfileCard />
        </div>
      )}
      <div class:list={["col-span-2 prose", { "sm:pt-[12rem]": path === "/" }]}>
        <slot />
      </div>
    </div>

    { path === "/" && (
      <script>
        // Astro dedupes identical inline scripts across view-transition
        // navigations, so this body only runs once ever — but the listener
        // it registers stays alive on `document` and re-queries the DOM
        // fresh on every subsequent navigation to this page.
        document.addEventListener('astro:page-load', () => {
          const banner = document.getElementById("hero-banner")
          const src = banner?.dataset.src
          if (banner && src) {
            banner.classList.remove("opacity-30")
            banner.classList.add("opacity-0")
            const img = new Image()
            img.onload = () => banner.classList.replace("opacity-0", "opacity-30")
            img.src = src
          }
        })
      </script>
    )}
  </body>
</html>
