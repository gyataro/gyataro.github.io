---
import BaseLayout from "../layouts/BaseLayout.astro";
import { EXTERNAL_LINK_ATTRS, getPageSchema } from "../consts";

const schema = await getPageSchema("/");
---

<BaseLayout schema={schema}>
  <h2 class="mb-1">About me</h2>
  <p>
    I am a 2nd year Ph.D. candidate jointly advised by
    <a href="https://www.comp.nus.edu.sg/~dongjs/" {...EXTERNAL_LINK_ATTRS}>Prof. Jin Song Dong</a> at the Programming Languages and Software Engineering (PLSE) Lab
    under National University of Singapore (NUS),
    and by <a href="http://linyun.info/" {...EXTERNAL_LINK_ATTRS}>Prof. Yun Lin</a> at the CoPhi Research Group
    under Shanghai Jiao Tong University (SJTU). 
  </p>

  <p>
    My research addresses a core challenge in human-agent interaction: <b>how to make software agents capable and reliable
    in real-world digital environments</b>. I design agents that reason about graphical user interfaces by grounding visual information in structured representations.
    I apply this work to <b>Internet security and software testing</b>, where agents help detect threats, uncover bugs, and verify that interfaces behave as intended.
  </p>
</BaseLayout>
