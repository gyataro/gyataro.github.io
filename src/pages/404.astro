---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Xiwen Teoh"
  description="The page you are looking for does not exist."
  noindex
>
  <section class="py-24 text-center">
    <p class="text-sm font-semibold text-muted-foreground">404</p>
    <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight">
      Page not found
    </h1>
    <p class="mt-4 text-muted-foreground">
      The page you are looking for does not exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full border border-border bg-card px-4 py-2 text-sm transition-colors hover:border-primary hover:text-primary"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
