---
import BaseLayout from "../layouts/BaseLayout.astro";
import Award from "../components/Award.astro";
import { getSortedAwards, groupByYear } from "../lib/collections";

const awards = await getSortedAwards();
const awardsByYear = groupByYear(awards, (a) => a.data.date.getFullYear());
const awardYears = Array.from(awardsByYear.keys()).sort((a, b) => b - a);
---
<BaseLayout>
  <h2 class="mb-1">Awards</h2>
  <p>A complete list of awards and recognition I have received.</p>
  <div class="not-prose flex flex-col gap-8">
    {awardYears.map((yr) => (
      <div class="flex flex-col gap-3">
        <p class="text-sm font-semibold text-muted uppercase tracking-wider">{yr}</p>
        {awardsByYear.get(yr)?.map(({ data }) => (
          <Award title={data.title} source={data.source} />
        ))}
      </div>
    ))}
  </div>
</BaseLayout>
